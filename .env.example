# ============================================
# PicSystem 环境变量示例
# 复制为 .env 并修改；.env 已在 .gitignore 中，切勿提交
# 推荐使用 deploy.sh / deploy.ps1 自动生成
# ============================================

# ---- 站点 ----
# 对外 HTTP 端口（唯一对外暴露的端口）
HTTP_PORT=9090
# 站点名称（可在管理后台修改）
SITE_NAME=PicSystem
TZ=Asia/Shanghai

# ---- 初始管理员（仅首次启动时创建，之后请在网页中修改密码）----
ADMIN_USERNAME=admin
# 必填：请设置为强密码
ADMIN_PASSWORD=

# ---- 安全密钥（必填，部署脚本会自动生成）----
# 会话签名密钥，至少 32 字节随机串
JWT_SECRET=
# 上游 chatgpt2api 的访问密钥；内置上游时同时作为其 CHATGPT2API_AUTH_KEY
UPSTREAM_API_KEY=

# ---- 数据库（compose 内联 PostgreSQL，不对外暴露端口）----
POSTGRES_DB=picsystem
POSTGRES_USER=picsystem
# 必填：强随机密码（仅字母数字下划线连字符）
POSTGRES_PASSWORD=

# ---- 上游 chatgpt2api ----
# 默认使用 compose 内置的 chatgpt2api（docker 内网地址）。
# 使用外部已部署的 2api 时，改为其地址，例如 https://api.example.com
UPSTREAM_BASE_URL=http://chatgpt2api
# 内置上游镜像
CHATGPT2API_IMAGE=ghcr.io/yukkcat/chatgpt2api:latest
# 内置 2api 控制台默认零端口暴露（推荐）。
# 如需在服务器本机访问控制台（添加/维护 ChatGPT 账号），取消下一行注释后 docker compose up -d。
# 注意分隔符：Linux/macOS 用冒号，Windows 用分号（改下面这行时按平台选择）。
# COMPOSE_FILE=docker-compose.yml:docker-compose.console.yml
# 控制台将绑定到 127.0.0.1:3000（仅本机回环，公网不可达）
CHATGPT2API_CONSOLE_PORT=3000
# 内置 2api 的线程令牌数（默认 120，一般无需修改）
# CHATGPT2API_THREAD_TOKENS=120

# ---- 数据库迁移（可选，一般无需修改）----
# 表结构升级在 api 容器启动时自动执行，迁移脚本见 backend/app/migrations/versions/
# 多实例部署时等待迁移锁的上限（秒）
# MIGRATIONS_LOCK_TIMEOUT_SECONDS=120
# 置为 true 时跳过标记为破坏性的迁移（删表 / 删列），谨慎使用
# MIGRATIONS_SKIP_DESTRUCTIVE=false

# ---- HTTPS（可选）----
# 通过反向代理以 HTTPS 暴露时设为 true，Cookie 将带 Secure 标记
COOKIE_SECURE=false

# ---- 反向代理（可选）----
# 站点端口绑定地址；外部反代与站点同机时建议 127.0.0.1:（仅本机反代可达）
# HTTP_BIND=127.0.0.1:
# X-Forwarded-For 生成方式：默认 $remote_addr（防伪造）；
# 外部有一层可信反代时改为 $proxy_add_x_forwarded_for 以透传真实客户端 IP
# XFF_MODE=$proxy_add_x_forwarded_for
